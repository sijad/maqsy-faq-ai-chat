# Files and directories that must NOT ship in the distributed plugin ZIP.
# Used by `npx wp-scripts plugin-zip`. Everything not listed here is included,
# so the human-readable JS/TS sources (src/, chat-runtime/src/) and the build
# config stay in the package alongside the compiled output in build/.

# VCS / project meta
.git
.github
.gitignore
.gitattributes
.distignore
.editorconfig
README.md
.DS_Store
*.zip
*.log

# wordpress.org directory assets (icon / banner / screenshots).
# The deploy action copies .wordpress-org/ to SVN /assets (sibling of trunk/);
# it must never end up inside the shipped plugin.
.wordpress-org
assets

# Dependencies (never distributed; reinstalled from the manifests)
node_modules
chat-runtime/node_modules
vendor

# Lockfiles
package-lock.json
composer.lock

# PHP tooling / linters
composer.json
phpcs.xml.dist

# JS/CSS linters
.eslintrc.js
.stylelintrc.json
.stylelintignore

# Local build artefact regenerated by `npm run build:tailwind`
chat-runtime/src/chat-app/tailwind.built.txt
