{
	"name": "maqsy-faq-ai-chat",
	"version": "1.0.0",
	"private": true,
	"description": "Maqsy WordPress plugin",
	"license": "GPL-2.0-or-later",
	"files": [
		"maqsy-faq-ai-chat.php",
		"uninstall.php",
		"index.php",
		"readme.txt",
		"admin/",
		"includes/",
		"public/",
		"languages/",
		"build/",
		"src/",
		"webpack.config.js",
		"tailwind.config.js",
		"chat-runtime/package.json",
		"chat-runtime/tsconfig.json",
		"chat-runtime/src/"
	],
	"scripts": {
		"build:tailwind": "tailwindcss -c tailwind.config.js -i chat-runtime/src/chat-app/tailwind.css -o chat-runtime/src/chat-app/tailwind.built.txt --minify",
		"build:chat": "rimraf build/chat && esbuild chat-runtime/src/chat-launcher/index.ts --bundle --splitting --format=esm --outdir=build/chat --entry-names=chat-launcher --tsconfig=chat-runtime/tsconfig.json --loader:.txt=text --define:process.env.NODE_ENV=\"'production'\" --minify",
		"typecheck": "npm --prefix chat-runtime run typecheck",
		"build": "npm run build:tailwind && npm run typecheck && wp-scripts build && npm run build:chat",
		"start": "concurrently \"tailwindcss -c tailwind.config.js -i chat-runtime/src/chat-app/tailwind.css -o chat-runtime/src/chat-app/tailwind.built.txt --watch\" \"wp-scripts start\" \"esbuild chat-runtime/src/chat-launcher/index.ts --bundle --splitting --format=esm --outdir=build/chat --entry-names=chat-launcher --tsconfig=chat-runtime/tsconfig.json --loader:.txt=text --define:process.env.NODE_ENV=\"'development'\" --watch\"",
		"lint:js": "wp-scripts lint-js src admin/js",
		"lint:css": "wp-scripts lint-style \"src/**/*.css\"",
		"format": "wp-scripts format src admin/js",
		"makepot": "wp i18n make-pot . languages/maqsy-faq-ai-chat.pot --slug=maqsy-faq-ai-chat --exclude=node_modules,vendor,build,chat-runtime/node_modules",
		"plugin-zip": "npm run build && wp-scripts plugin-zip"
	},
	"devDependencies": {
		"@wordpress/api-fetch": "^7.54.0",
		"@wordpress/block-editor": "^17.0.0",
		"@wordpress/blocks": "^15.27.0",
		"@wordpress/components": "^40.0.0",
		"@wordpress/eslint-plugin": "^21.0.0",
		"@wordpress/scripts": "^30.0.0",
		"@wordpress/server-side-render": "^6.30.0",
		"@wordpress/stylelint-config": "^23.0.0",
		"autoprefixer": "^10.5.4",
		"concurrently": "^10.0.5",
		"esbuild": "^0.27.7",
		"jquery": "^4.0.0",
		"postcss": "^8.5.26",
		"rimraf": "^6.1.3",
		"tailwindcss": "^3.4.19",
		"tailwindcss-animate": "^1.0.7",
		"typescript": "^5.9.3"
	}
}
